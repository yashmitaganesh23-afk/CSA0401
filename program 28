#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char word[20], line[100];

    fp = fopen("file.txt", "w");

    fprintf(fp, "Operating System\n");
    fprintf(fp, "UNIX system calls\n");
    fprintf(fp, "File management\n");
    fprintf(fp, "UNIX commands\n");
    fprintf(fp, "Linux operating system\n");

    fclose(fp);

    printf("Enter word to search: ");
    scanf("%s", word);

    fp = fopen("file.txt", "r");

    printf("\nMatching lines:\n");

    while (fgets(line, sizeof(line), fp))
    {
        if (strstr(line, word))
            printf("%s", line);
    }

    fclose(fp);

    return 0;
}


