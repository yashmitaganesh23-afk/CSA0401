#include <stdio.h>
#include <string.h>

struct User
{
    char name[20];
    char files[10][20];
    int count;
};

int main()
{
    struct User u[10];
    int n = 0, ch, i, j, found;
    char user[20], file[20];

    while (1)
    {
        printf("\n1.Create User\n2.Create File\n3.Display\n4.Search\n5.Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);

        if (ch == 1)
        {
            printf("Enter user name: ");
            scanf("%s", user);

            strcpy(u[n].name, user);
            u[n].count = 0;
            n++;

            printf("User created.\n");
        }

        else if (ch == 2)
        {
            printf("Enter user name: ");
            scanf("%s", user);

            found = -1;

            for (i = 0; i < n; i++)
                if (strcmp(u[i].name, user) == 0)
                    found = i;

            if (found == -1)
                printf("User not found.\n");
            else
            {
                printf("Enter file name: ");
                scanf("%s", file);

                strcpy(u[found].files[u[found].count], file);
                u[found].count++;

                printf("File created.\n");
            }
        }

        else if (ch == 3)
        {
            for (i = 0; i < n; i++)
            {
                printf("\nUser: %s\n", u[i].name);

                for (j = 0; j < u[i].count; j++)
                    printf("  %s\n", u[i].files[j]);
            }
        }

        else if (ch == 4)
        {
            printf("Enter user name: ");
            scanf("%s", user);

            printf("Enter file name: ");
            scanf("%s", file);

            found = 0;

            for (i = 0; i < n; i++)
                if (strcmp(u[i].name, user) == 0)
                    for (j = 0; j < u[i].count; j++)
                        if (strcmp(u[i].files[j], file) == 0)
                            found = 1;

            if (found)
                printf("File found.\n");
            else
                printf("File not found.\n");
        }

        else if (ch == 5)
            break;

        else
            printf("Invalid choice.\n");
    }

    return 0;
}


