#include <stdio.h>
#include <pthread.h>
#include <unistd.h>

#define N 5

pthread_mutex_t chopstick[N];

void *philosopher(void *num)
{
    int id = *(int *)num;

    printf("Philosopher %d is thinking...\n", id);
    sleep(1);

    // Pick up left chopstick
    pthread_mutex_lock(&chopstick[id]);
    printf("Philosopher %d picked up left chopstick %d\n", id, id);

    // Pick up right chopstick
    pthread_mutex_lock(&chopstick[(id + 1) % N]);
    printf("Philosopher %d picked up right chopstick %d\n", id, (id + 1) % N);

    // Eat
    printf("Philosopher %d is eating...\n", id);
    sleep(2);

    // Put down chopsticks
    pthread_mutex_unlock(&chopstick[id]);
    pthread_mutex_unlock(&chopstick[(id + 1) % N]);

    printf("Philosopher %d has finished eating.\n", id);

    return NULL;
}

int main()
{
    pthread_t ph[N];
    int id[N];

    // Initialize mutexes
    for (int i = 0; i < N; i++)
        pthread_mutex_init(&chopstick[i], NULL);

    // Create philosopher threads
    for (int i = 0; i < N; i++)
    {
        id[i] = i;
        pthread_create(&ph[i], NULL, philosopher, &id[i]);
    }

    // Wait for all philosophers to finish
    for (int i = 0; i < N; i++)
        pthread_join(ph[i], NULL);

    // Destroy mutexes
    for (int i = 0; i < N; i++)
        pthread_mutex_destroy(&chopstick[i]);

    return 0;
}




