#include <stdio.h>

int main()
{
    int block[20], n, i;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("\nLinked Allocation:\n");

    for (i = 0; i < n - 1; i++)
        printf("Block %d -> Block %d\n", block[i], block[i + 1]);

    printf("Block %d -> NULL\n", block[n - 1]);

    printf("\nFirst Block: %d\n", block[0]);
    printf("Last Block : %d\n", block[n - 1]);

    return 0;
}

