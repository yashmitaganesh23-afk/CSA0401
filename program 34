#include <stdio.h>

int main()
{
    int n, i;
    char fileName[30];

    printf("Enter the file name: ");
    scanf("%s", fileName);

    printf("Enter the number of records: ");
    scanf("%d", &n);

    printf("\nSequential File Allocation\n");
    printf("------------------------------\n");
    printf("File Name : %s\n\n", fileName);

    printf("Record No\tBlock No\n");

    for(i = 0; i < n; i++)
    {
        printf("%d\t\t%d\n", i + 1, i + 1);
    }

    printf("\nAccessing records sequentially:\n");

    for(i = 0; i < n; i++)
    {
        printf("Reading Record %d\n", i + 1);
    }

    return 0;
}

