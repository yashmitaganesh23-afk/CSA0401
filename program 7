#include <stdio.h>

int main()
{
    int n, i, j;
    int at[10], bt[10], wt[10], tat[10], ct[10];
    int completed[10] = {0};
    int time = 0, count = 0, shortest;
    float avg_wt = 0, avg_tat = 0;

    printf("Enter the number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nEnter Arrival Time of P%d: ", i + 1);
        scanf("%d", &at[i]);

        printf("Enter Burst Time of P%d: ", i + 1);
        scanf("%d", &bt[i]);
    }

    while(count < n)
    {
        shortest = -1;

        for(i = 0; i < n; i++)
        {
            if(at[i] <= time && completed[i] == 0)
            {
                if(shortest == -1 || bt[i] < bt[shortest])
                {
                    shortest = i;
                }
            }
        }

        if(shortest == -1)
        {
            time++;
        }
        else
        {
            wt[shortest] = time - at[shortest];
            time += bt[shortest];
            ct[shortest] = time;
            tat[shortest] = ct[shortest] - at[shortest];
            completed[shortest] = 1;
            count++;

            avg_wt += wt[shortest];
            avg_tat += tat[shortest];
        }
    }

    printf("\nNon-Preemptive SJF Scheduling\n");
    printf("-------------------------------------------------------------\n");
    printf("Process\tAT\tBT\tCT\tWT\tTAT\n");
    printf("-------------------------------------------------------------\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], ct[i], wt[i], tat[i]);
    }

    printf("-------------------------------------------------------------\n");
    printf("Average Waiting Time = %.2f\n", avg_wt / n);
    printf("Average Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}



